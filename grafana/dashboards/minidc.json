{
  "uid": "campussoporte-dc",
  "title": "CampusSoporte | Centro de Datos: tráfico e incidencias",
  "tags": [
    "campussoporte",
    "centro-de-datos",
    "nginx",
    "mariadb",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "① Balanceo de carga — ¿a qué nodo llegó cada petición?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "bargauge",
      "title": "Peticiones por nodo (rango elegido)",
      "datasource": {
        "type": "loki",
        "uid": "loki-minidc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "description": "Cuántas peticiones atendió cada nodo. Con round robin las barras deben quedar casi iguales.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-minidc"
          },
          "expr": "sum by (nodo) (count_over_time({servicio=\"lb\"} | json | __error__=\"\" | nodo != \"\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{nodo}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5b6b82"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "web1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1f6feb"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "web2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d97706"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "web3"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#16a34a"
                }
              }
            ]
          }
        ]
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Tráfico por nodo (peticiones cada 10 s)",
      "datasource": {
        "type": "loki",
        "uid": "loki-minidc"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-minidc"
          },
          "expr": "sum by (nodo) (count_over_time({servicio=\"lb\"} | json | __error__=\"\" | nodo != \"\" [10s]))",
          "legendFormat": "{{nodo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "web1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1f6feb"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "web2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d97706"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "web3"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#16a34a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Códigos de estado HTTP",
      "datasource": {
        "type": "loki",
        "uid": "loki-minidc"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "description": "200 = OK · 404 = no existe · 502/504 = el balanceador no pudo llegar al nodo",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-minidc"
          },
          "expr": "sum by (estado) (count_over_time({servicio=\"lb\"} | json | __error__=\"\" [10s]))",
          "legendFormat": "HTTP {{estado}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Tiempo de respuesta p95",
      "datasource": {
        "type": "loki",
        "uid": "loki-minidc"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-minidc"
          },
          "expr": "quantile_over_time(0.95, {servicio=\"lb\"} | json | __error__=\"\" | unwrap t_total [1m]) by (servicio)",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Errores 5xx (rango)",
      "datasource": {
        "type": "loki",
        "uid": "loki-minidc"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-minidc"
          },
          "expr": "sum(count_over_time({servicio=\"lb\"} | json | __error__=\"\" | estado >= 500 [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 6
    },
    {
      "type": "row",
      "title": "② Sistema CampusSoporte — Base de datos MariaDB",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": [],
      "id": 7
    },
    {
      "type": "barchart",
      "title": "Visitas al portal por nodo",
      "datasource": {
        "type": "mysql",
        "uid": "mariadb-minidc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "description": "Cada vez que se abre la página, la API inserta una fila en la tabla visitas.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mariadb-minidc"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT nodo, COUNT(*) AS visitas FROM visitas GROUP BY nodo ORDER BY nodo"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "nodo",
        "orientation": "auto",
        "showValue": "always",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "colorByField": "nodo"
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Pruebas de carga guardadas",
      "datasource": {
        "type": "mysql",
        "uid": "mariadb-minidc"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mariadb-minidc"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT fecha, total, exitos, fallos, t_prom_ms AS 'ms prom', distribucion, cliente FROM pruebas ORDER BY id DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 9
    },
    {
      "type": "row",
      "title": "③ Registros de la infraestructura — Loki",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": [],
      "id": 10
    },
    {
      "type": "logs",
      "title": "Bitácora del balanceador (JSON)",
      "datasource": {
        "type": "loki",
        "uid": "loki-minidc"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-minidc"
          },
          "expr": "{servicio=\"lb\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "id": 11
    },
    {
      "type": "logs",
      "title": "Advertencias y errores de todos los contenedores",
      "datasource": {
        "type": "loki",
        "uid": "loki-minidc"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-minidc"
          },
          "expr": "{proyecto=\"campussoporte\"} |~ \"(?i)(error|warn|fail|emerg|crit)\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "id": 12
    },
    {
      "id": 13,
      "type": "barchart",
      "title": "Incidencias por estado",
      "datasource": {
        "type": "mysql",
        "uid": "mariadb-minidc"
      },
      "description": "Consulta SQL real a MariaDB; los datos provienen de las incidencias registradas en CampusSoporte.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mariadb-minidc"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT estado AS Etiqueta, COUNT(*) AS Total FROM incidencias GROUP BY estado ORDER BY estado"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 76,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Etiqueta",
        "orientation": "auto",
        "showValue": "always",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "type": "barchart",
      "title": "Incidencias por categoría",
      "datasource": {
        "type": "mysql",
        "uid": "mariadb-minidc"
      },
      "description": "Consulta SQL real a MariaDB; los datos provienen de las incidencias registradas en CampusSoporte.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mariadb-minidc"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT categoria AS Etiqueta, COUNT(*) AS Total FROM incidencias GROUP BY categoria ORDER BY categoria"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 76,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Etiqueta",
        "orientation": "auto",
        "showValue": "always",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "description": "Dashboard académico: balanceo Nginx, incidencias MariaDB y logs Loki recolectados por Alloy."
